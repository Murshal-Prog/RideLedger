# RideLedger — Environment Variables Configuration
# Copy this file to .env.local to configure your local runtime:
# cp .env.example .env.local

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="RideLedger"
NEXT_PUBLIC_APP_ENV=development

# Supabase Authentication & PostgreSQL Database (Production & Staging)
# When valid keys are provided, RideLedger connects directly to your Supabase project with Row Level Security.
# When placeholder values remain, RideLedger automatically operates in Local Storage Isolation mode for offline testing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Server-side administrative tasks only, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
