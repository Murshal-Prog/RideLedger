# RideLedger — Environment Variables Example
# Duplicate this file to .env.local and populate with your local values.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="RideLedger"
NEXT_PUBLIC_APP_ENV=development

# Supabase Persistence & Authentication (For Future Phases)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
